{
	"name": "JunkyardBrawl",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			}
		},
		"ReplicatedFirst": {
			"$path": "src/first"
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			}
		},
		"ServerStorage": {
			"Arenas": {
				"$className": "Folder",
				"BrokenHighway": {
					"$path": "maps/generated/BrokenHighway.rbxmx"
				},
				"JunkyardIsles": {
					"$path": "maps/generated/JunkyardIsles.rbxmx"
				},
				"NeonMotel": {
					"$path": "maps/generated/NeonMotel.rbxmx"
				}
			}
		},
		"StarterPlayer": {
			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/client"
				}
			}
		},
		"TextChatService": {
			"$properties": {
				"ChatVersion": "TextChatService"
			}
		},
		"Lighting": {
			"$properties": {
				"LightingStyle": "Realistic",
				"GlobalShadows": true
			}
		},
		"LocalizationService": {
			"GameStrings": {
				"$path": "src/localization/GameStrings.csv"
			}
		},
		"Workspace": {
			"$properties": {
				"StreamingEnabled": true,
				"StreamingMinRadius": 128,
				"StreamingTargetRadius": 256
			},
			"Lobby": {
				"$path": "maps/generated/Hideout.rbxmx"
			}
		}
	}
}
