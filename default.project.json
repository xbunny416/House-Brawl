{
	"name": "JunkyardBrawl",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			}
		},
		"ServerStorage": {
			"Arenas": {
				"$className": "Folder",
				"BrokenHighway": {
					"$path": "maps/generated/BrokenHighway.rbxmx"
				}
			}
		},
		"StarterPlayer": {
			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/client"
				}
			}
		},
		"LocalizationService": {
			"GameStrings": {
				"$path": "src/localization/GameStrings.csv"
			}
		},
		"Workspace": {
			"$properties": {
				"StreamingEnabled": true,
				"StreamingMinRadius": 128,
				"StreamingTargetRadius": 256
			},
			"Lobby": {
				"$path": "maps/generated/RustDiner.rbxmx"
			}
		}
	}
}
